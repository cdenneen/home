{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis.external-development-supervisor.observability-health",
  "type": "object",
  "required": ["schema", "schema_version", "status", "updated_at", "errors"],
  "properties": {
    "schema": {
      "const": "axis.external-development-supervisor.observability-health"
    },
    "schema_version": { "const": "1.0.0" },
    "status": { "const": "degraded" },
    "updated_at": { "type": "string", "format": "date-time" },
    "errors": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "error_id",
          "operation",
          "source",
          "primary_error",
          "observability_error",
          "occurred_at"
        ],
        "properties": {
          "error_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
          "operation": { "type": "string", "minLength": 1 },
          "source": { "type": "string", "minLength": 1 },
          "primary_error": { "type": "string", "minLength": 1 },
          "observability_error": { "type": "string", "minLength": 1 },
          "occurred_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
