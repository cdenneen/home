{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis.external-development-supervisor.active-mission",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "mission_id",
    "created_at",
    "updated_at",
    "desired_end_state",
    "current_state",
    "missing_gates",
    "generated_actions",
    "retired_actions",
    "invalidation_map",
    "active_assignments",
    "completed_assignments",
    "external_blockers",
    "action_effectiveness",
    "effectiveness_metrics",
    "graduation_progress",
    "termination_condition",
    "observations"
  ],
  "properties": {
    "schema": {
      "const": "axis.external-development-supervisor.active-mission"
    },
    "schema_version": { "const": "4.0.0" },
    "mission_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "desired_end_state": { "const": "all-capabilities-graduated" },
    "current_state": {
      "enum": ["active", "completed", "blocked-external"]
    },
    "missing_gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "capability",
          "gate",
          "state",
          "evidence",
          "external_only"
        ],
        "properties": {
          "capability": { "type": "string", "minLength": 1 },
          "gate": { "type": "string", "minLength": 1 },
          "state": { "type": "string", "minLength": 1 },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "external_only": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "generated_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "kind",
          "target",
          "gate",
          "reason",
          "executable",
          "attempt_limit",
          "engineering_purpose",
          "gate_owner",
          "expected_gates",
          "expected_capabilities",
          "expected_milestones",
          "expected_debt_reduction",
          "expected_evidence",
          "capability_context",
          "merge_impact_projection",
          "convergence_fingerprint",
          "evidence_model_fingerprint",
          "applicability_model_revision",
          "pre_snapshot",
          "suppression_fingerprint",
          "binding",
          "lifecycle"
        ],
        "properties": {
          "action_id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "gate": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "executable": { "const": true },
          "attempt_limit": { "type": "integer", "const": 1 },
          "source_ref": { "type": ["string", "null"] },
          "assignment_id": { "type": ["string", "null"] },
          "engineering_purpose": { "type": "string", "minLength": 1 },
          "gate_owner": { "type": "string", "minLength": 1 },
          "expected_gates": {
            "type": "array",
            "items": { "$ref": "#/$defs/expected_gate" }
          },
          "expected_capabilities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "expected_milestones": {
            "type": "array",
            "items": { "type": "string" }
          },
          "expected_debt_reduction": {
            "type": "array",
            "items": { "type": "object" }
          },
          "expected_evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "capability_context": {
            "type": "array",
            "items": { "type": "object" }
          },
          "merge_impact_projection": { "type": "object" },
          "convergence_fingerprint": { "type": ["string", "null"] },
          "evidence_model_fingerprint": { "type": "string" },
          "applicability_model_revision": { "type": "string", "minLength": 1 },
          "pre_snapshot": { "type": "object" },
          "suppression_fingerprint": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "binding": { "type": "object" },
          "lifecycle": { "enum": ["CURRENT", "STALE"] }
        },
        "additionalProperties": false
      }
    },
    "retired_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "classification",
          "retired_at",
          "purpose",
          "binding",
          "replacement_action_id"
        ],
        "properties": {
          "action_id": { "type": "string" },
          "classification": {
            "enum": ["SATISFIED", "STALE", "SUPERSEDED", "BLOCKED"]
          },
          "retired_at": { "type": "string", "format": "date-time" },
          "purpose": { "type": "string" },
          "binding": { "type": "object" },
          "replacement_action_id": { "type": ["string", "null"] }
        },
        "additionalProperties": false
      }
    },
    "invalidation_map": { "type": "object" },
    "active_assignments": {
      "type": "array",
      "items": { "$ref": "#/$defs/assignment" }
    },
    "completed_assignments": {
      "type": "array",
      "items": { "$ref": "#/$defs/assignment" }
    },
    "external_blockers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ref", "kind", "reason"],
        "properties": {
          "ref": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    },
    "action_effectiveness": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "assignment_id",
          "action_id",
          "suppression_fingerprint",
          "baseline_fingerprint",
          "observed_fingerprint",
          "expected_gates",
          "observed_gates",
          "observed_delta",
          "pre_snapshot",
          "post_snapshot",
          "normalized_delta",
          "zero_effect_cycles",
          "classification",
          "evaluated_at"
        ],
        "properties": {
          "assignment_id": { "type": "string", "minLength": 1 },
          "action_id": { "type": "string", "minLength": 1 },
          "suppression_fingerprint": { "type": "string" },
          "baseline_fingerprint": { "type": "string" },
          "observed_fingerprint": { "type": "string" },
          "expected_gates": {
            "type": "array",
            "items": { "$ref": "#/$defs/expected_gate" }
          },
          "observed_gates": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["capability", "gate", "state"],
              "properties": {
                "capability": { "type": "string" },
                "gate": { "type": "string" },
                "state": { "type": "string" }
              },
              "additionalProperties": false
            }
          },
          "observed_delta": { "type": "boolean" },
          "pre_snapshot": { "type": "object" },
          "post_snapshot": { "type": "object" },
          "normalized_delta": { "type": "object" },
          "zero_effect_cycles": { "type": "integer", "minimum": 0 },
          "classification": {
            "enum": [
              "effective",
              "applicability-revised",
              "zero-effect",
              "state-model-defect"
            ]
          },
          "evaluated_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "effectiveness_metrics": {
      "type": "object",
      "required": [
        "assignments_evaluated",
        "effective_assignments",
        "zero_effect_assignments",
        "suppressed_fingerprints",
        "state_model_defects",
        "applicability_revisions",
        "gates_reduced",
        "confidence_delta",
        "effectiveness_percent"
      ],
      "properties": {
        "assignments_evaluated": { "type": "integer", "minimum": 0 },
        "effective_assignments": { "type": "integer", "minimum": 0 },
        "zero_effect_assignments": { "type": "integer", "minimum": 0 },
        "suppressed_fingerprints": { "type": "integer", "minimum": 0 },
        "state_model_defects": { "type": "integer", "minimum": 0 },
        "applicability_revisions": { "type": "integer", "minimum": 0 },
        "gates_reduced": { "type": "integer", "minimum": 0 },
        "confidence_delta": { "type": "number" },
        "effectiveness_percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      },
      "additionalProperties": false
    },
    "graduation_progress": {
      "type": "object",
      "required": [
        "graduated",
        "denominator",
        "percent",
        "missing_gate_count",
        "active_assignment_count",
        "completed_assignment_count",
        "suppressed_action_count"
      ],
      "properties": {
        "graduated": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 0 },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 },
        "missing_gate_count": { "type": "integer", "minimum": 0 },
        "active_assignment_count": { "type": "integer", "minimum": 0 },
        "completed_assignment_count": { "type": "integer", "minimum": 0 },
        "suppressed_action_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "termination_condition": {
      "type": "object",
      "required": [
        "desired_state_achieved",
        "every_remaining_path_external_only",
        "should_terminate",
        "reason"
      ],
      "properties": {
        "desired_state_achieved": { "type": "boolean" },
        "every_remaining_path_external_only": { "type": "boolean" },
        "should_terminate": { "type": "boolean" },
        "reason": {
          "enum": [
            "desired-state-achieved",
            "all-remaining-paths-external-only",
            "work-remains"
          ]
        }
      },
      "additionalProperties": false
    },
    "observations": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["observed_at", "source", "summary"],
        "properties": {
          "observed_at": { "type": "string", "format": "date-time" },
          "source": { "type": "string", "minLength": 1 },
          "summary": { "type": "string", "maxLength": 4096 }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "expected_gate": {
      "type": "object",
      "required": ["capability", "gate", "from_state", "to_state"],
      "properties": {
        "capability": { "type": "string", "minLength": 1 },
        "gate": { "type": "string", "minLength": 1 },
        "from_state": { "type": "string", "minLength": 1 },
        "to_state": { "const": "passed" }
      },
      "additionalProperties": false
    },
    "assignment": {
      "type": "object",
      "required": [
        "assignment_id",
        "project",
        "work_item",
        "lifecycle_state",
        "result_state"
      ],
      "properties": {
        "assignment_id": { "type": "string", "minLength": 1 },
        "project": { "type": "string" },
        "work_item": { "type": "string" },
        "lifecycle_state": { "type": "string" },
        "result_state": { "type": "string" },
        "action_contract": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
