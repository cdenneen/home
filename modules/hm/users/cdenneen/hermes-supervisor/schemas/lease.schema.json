{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis.external-development-supervisor.lease",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "lease_id",
    "assignment_id",
    "owner_run_id",
    "fencing_token",
    "resources",
    "read_only",
    "acquired_at_epoch",
    "heartbeat_at_epoch",
    "expires_at_epoch"
  ],
  "properties": {
    "schema": { "const": "axis.external-development-supervisor.lease" },
    "schema_version": { "const": "1.0.0" },
    "lease_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "assignment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "owner_run_id": { "type": "string", "minLength": 1 },
    "fencing_token": { "type": "string", "minLength": 16 },
    "resources": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1,
      "uniqueItems": true
    },
    "read_only": { "type": "boolean" },
    "acquired_at_epoch": { "type": "integer", "minimum": 1 },
    "heartbeat_at_epoch": { "type": "integer", "minimum": 1 },
    "expires_at_epoch": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
