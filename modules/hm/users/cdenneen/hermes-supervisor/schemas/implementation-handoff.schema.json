{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis.external-development-supervisor.implementation-handoff",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "assignment_id",
    "work_item",
    "repository",
    "responsibility",
    "repository_ownership",
    "branch",
    "commit",
    "allowed_paths",
    "changed_paths",
    "tests",
    "mr_iid",
    "mr_url",
    "created_at",
    "state",
    "origin_finding",
    "targeted_replay",
    "worktree_context"
  ],
  "properties": {
    "schema": {
      "const": "axis.external-development-supervisor.implementation-handoff"
    },
    "schema_version": { "const": "4.0.0" },
    "assignment_id": { "type": "string", "minLength": 1 },
    "work_item": { "type": "string", "minLength": 1 },
    "repository": { "type": "string", "minLength": 1 },
    "responsibility": {
      "enum": [
        "supervisor-orchestration/temporary-slack/cron",
        "axis-runtime/product",
        "contracts/planning-records",
        "deployment/realistic-validation"
      ]
    },
    "repository_ownership": { "type": "object" },
    "branch": { "type": "string", "minLength": 1 },
    "commit": { "type": "string", "minLength": 1 },
    "allowed_paths": { "type": "array", "items": { "type": "string" } },
    "changed_paths": { "type": "array", "items": { "type": "string" } },
    "tests": { "type": "array", "items": { "type": "object" } },
    "mr_iid": { "type": ["integer", "null"], "minimum": 1 },
    "mr_url": { "type": ["string", "null"], "format": "uri" },
    "source_main_sha": { "type": ["string", "null"] },
    "created_at": { "type": "string", "format": "date-time" },
    "state": { "enum": ["ready-for-integration", "integrated", "blocked"] },
    "origin_finding": { "type": ["object", "null"] },
    "targeted_replay": { "type": ["object", "null"] },
    "worktree_context": { "type": ["object", "null"] },
    "dispatch_generation": { "enum": ["A", "B", null] },
    "delivery_lane": {
      "enum": [
        "BACKLOG",
        "READY",
        "IMPLEMENTATION",
        "HANDOFF",
        "REVIEW",
        "REPAIR",
        "INTEGRATION",
        "MERGE_READY",
        "POST_MAIN_VERIFICATION",
        "DEPLOYMENT",
        "VALIDATION",
        "DECISION",
        "GRADUATED",
        "BLOCKED",
        null
      ]
    }
  },
  "additionalProperties": false
}
