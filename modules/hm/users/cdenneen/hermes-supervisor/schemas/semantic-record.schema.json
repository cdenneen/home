{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis.external-development-supervisor.semantic-record",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "target_ref",
    "candidate_slices",
    "evidence_inspected",
    "permitted_actions",
    "prohibited_actions",
    "direct_blocker",
    "transitive_blocker_chain",
    "authority_source",
    "authority_resolution",
    "next_state_changing_event",
    "revalidated_at"
  ],
  "properties": {
    "schema": {
      "const": "axis.external-development-supervisor.semantic-record"
    },
    "schema_version": { "const": "1.0.0" },
    "target_ref": { "type": "string", "minLength": 1 },
    "candidate_slices": { "type": "array" },
    "evidence_inspected": { "type": "array", "minItems": 1 },
    "permitted_actions": { "type": "array" },
    "prohibited_actions": { "type": "array" },
    "transitive_blocker_chain": { "type": "array" },
    "authority_source": { "type": "array" },
    "authority_resolution": { "type": "object" },
    "next_state_changing_event": { "type": "string" },
    "revalidated_at": { "type": "string" }
  },
  "additionalProperties": true
}
