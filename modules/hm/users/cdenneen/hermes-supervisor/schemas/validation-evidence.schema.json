{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis.external-development-supervisor.validation-evidence",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "evidence_id",
    "recorded_at",
    "stream",
    "evidence",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "axis.external-development-supervisor.validation-evidence"
    },
    "schema_version": { "const": "1.0.0" },
    "evidence_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "recorded_at": { "type": "string", "format": "date-time" },
    "stream": { "type": "string", "minLength": 1 },
    "evidence": { "type": "object" },
    "findings": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string" },
          {
            "type": "object",
            "required": ["summary"],
            "properties": {
              "summary": { "type": "string", "minLength": 1 },
              "classification": { "type": "string" },
              "capability": { "type": ["string", "null"] },
              "gate": { "type": ["string", "null"] },
              "repository": { "type": ["string", "null"] },
              "responsibility": { "type": ["string", "null"] },
              "owner_ref": { "type": ["string", "null"] },
              "owner_refs": { "type": "array", "items": { "type": "string" } },
              "allowed_paths": {
                "type": "array",
                "items": { "type": "string" }
              },
              "required_tests": {
                "type": "array",
                "items": { "type": "string" }
              },
              "roadmap_authorized": { "type": "boolean" },
              "planning_record": { "type": ["object", "null"] },
              "replay": { "type": ["object", "null"] }
            },
            "additionalProperties": true
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
