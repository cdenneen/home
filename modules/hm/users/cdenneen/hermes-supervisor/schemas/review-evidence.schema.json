{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis.external-development-supervisor.review-evidence",
  "$defs": {
    "channel": {
      "type": "object",
      "required": ["complete", "count", "digest"],
      "properties": {
        "complete": { "type": "boolean" },
        "count": { "type": "integer", "minimum": 0 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "disposition": {
      "type": "object",
      "required": [
        "disposition_id",
        "finding_id",
        "reviewed_sha",
        "status",
        "rationale",
        "evidence"
      ],
      "properties": {
        "disposition_id": {
          "type": "string",
          "pattern": "^disposition-[0-9a-f]{24}$"
        },
        "finding_id": { "type": "string", "pattern": "^finding-[0-9a-f]{24}$" },
        "reviewed_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "status": {
          "enum": [
            "fixed",
            "false-positive",
            "superseded",
            "accepted-risk",
            "deferred"
          ]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "evidence": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "repository",
    "pr_number",
    "pr_url",
    "author",
    "current_sha",
    "status",
    "session_id",
    "started_at",
    "updated_at",
    "deadline_at",
    "poll_count",
    "pr_state",
    "is_draft",
    "policy",
    "requested_reviewers",
    "reviewers",
    "checks",
    "channels",
    "diff",
    "findings",
    "independent_review",
    "blockers",
    "poll_history",
    "last_error"
  ],
  "properties": {
    "schema": {
      "const": "axis.external-development-supervisor.review-evidence"
    },
    "schema_version": { "const": "4.0.0" },
    "repository": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "pr_number": { "type": "integer", "minimum": 1 },
    "pr_url": { "type": ["string", "null"], "format": "uri" },
    "author": { "type": "string", "minLength": 1 },
    "current_sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
    "status": {
      "enum": [
        "settling",
        "review-required",
        "blocked",
        "ready",
        "timeout",
        "unavailable"
      ]
    },
    "session_id": { "type": "string", "format": "uuid" },
    "started_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "deadline_at": { "type": "string", "format": "date-time" },
    "poll_count": { "type": "integer", "minimum": 0 },
    "pr_state": { "type": "string" },
    "is_draft": { "type": "boolean" },
    "policy": {
      "type": "object",
      "required": [
        "required_human_approvals",
        "approved_human_reviewers",
        "required_checks"
      ],
      "properties": {
        "required_human_approvals": { "type": "integer", "minimum": 1 },
        "approved_human_reviewers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["id", "login"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "login": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          }
        },
        "required_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": ["name", "producer"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "producer": {
                "type": "object",
                "required": ["kind", "id", "login"],
                "properties": {
                  "kind": { "enum": ["github_app", "automation", "user"] },
                  "id": { "type": "string", "minLength": 1 },
                  "login": { "type": "string", "minLength": 1 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "requested_reviewers": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "reviewer",
          "account_id",
          "kind",
          "user_type",
          "app_slug",
          "is_automation",
          "state",
          "reviewed_sha",
          "reviewed_at"
        ],
        "properties": {
          "reviewer": { "type": "string", "minLength": 1 },
          "account_id": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["human", "automation"] },
          "user_type": { "type": ["string", "null"] },
          "app_slug": { "type": ["string", "null"] },
          "is_automation": { "type": "boolean" },
          "state": { "type": "string" },
          "reviewed_sha": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{40}$"
          },
          "reviewed_at": { "type": ["string", "null"], "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "check_id",
          "name",
          "state",
          "url",
          "sha",
          "producer",
          "started_at",
          "completed_at"
        ],
        "properties": {
          "check_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "state": { "enum": ["passed", "pending", "failed", "skipped"] },
          "url": { "type": ["string", "null"], "format": "uri" },
          "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "producer": {
            "type": "object",
            "required": ["kind", "id", "login"],
            "properties": {
              "kind": { "enum": ["github_app", "automation", "user"] },
              "id": { "type": "string", "minLength": 1 },
              "login": { "type": "string", "minLength": 1 }
            },
            "additionalProperties": false
          },
          "started_at": { "type": ["string", "null"], "format": "date-time" },
          "completed_at": { "type": ["string", "null"], "format": "date-time" }
        },
        "additionalProperties": false
      }
    },
    "channels": {
      "type": "object",
      "required": [
        "reviews",
        "review_comments",
        "issue_comments",
        "checks",
        "diff"
      ],
      "properties": {
        "reviews": { "$ref": "#/$defs/channel" },
        "review_comments": { "$ref": "#/$defs/channel" },
        "issue_comments": { "$ref": "#/$defs/channel" },
        "checks": { "$ref": "#/$defs/channel" },
        "diff": { "$ref": "#/$defs/channel" }
      },
      "additionalProperties": false
    },
    "diff": {
      "type": "object",
      "required": ["reviewed_sha", "digest", "size_bytes"],
      "properties": {
        "reviewed_sha": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{40}$"
        },
        "digest": {
          "type": ["string", "null"],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "size_bytes": { "type": "integer", "minimum": 0, "maximum": 500000 }
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "finding_id",
          "channel",
          "external_id",
          "reviewer",
          "severity",
          "path",
          "line",
          "body",
          "url",
          "reviewed_sha",
          "state",
          "disposition"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "pattern": "^finding-[0-9a-f]{24}$"
          },
          "channel": {
            "enum": [
              "reviews",
              "review_comments",
              "issue_comments",
              "independent_review"
            ]
          },
          "external_id": { "type": "string", "minLength": 1 },
          "reviewer": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "path": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "body": { "type": "string", "minLength": 1 },
          "url": { "type": ["string", "null"], "format": "uri" },
          "reviewed_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "state": { "enum": ["active", "stale"] },
          "disposition": {
            "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/disposition" }]
          }
        },
        "additionalProperties": false
      }
    },
    "independent_review": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": [
            "reviewer",
            "model",
            "reviewed_sha",
            "diff_digest",
            "reviewed_at",
            "summary",
            "finding_ids"
          ],
          "properties": {
            "reviewer": { "const": "gpt-5.4-independent" },
            "model": { "const": "gpt-5.4" },
            "reviewed_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "diff_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "reviewed_at": { "type": "string", "format": "date-time" },
            "summary": { "type": "string" },
            "finding_ids": {
              "type": "array",
              "items": { "type": "string", "pattern": "^finding-[0-9a-f]{24}$" }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "poll_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["poll", "observed_at", "sha", "status"],
        "properties": {
          "poll": { "type": "integer", "minimum": 1 },
          "observed_at": { "type": "string", "format": "date-time" },
          "sha": { "type": ["string", "null"], "pattern": "^[0-9a-f]{40}$" },
          "status": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "last_error": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
