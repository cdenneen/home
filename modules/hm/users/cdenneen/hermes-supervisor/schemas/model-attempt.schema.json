{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis.external-development-supervisor.model-attempt",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "attempt_id",
    "role",
    "model",
    "provider",
    "run",
    "assignment",
    "attempt",
    "result",
    "recorded_at_epoch"
  ],
  "properties": {
    "schema": { "const": "axis.external-development-supervisor.model-attempt" },
    "schema_version": { "const": "1.0.0" },
    "attempt_id": { "type": "string", "minLength": 1 },
    "role": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "run": { "type": "string", "minLength": 1 },
    "assignment": { "type": "string", "minLength": 1 },
    "attempt": { "type": "integer", "minimum": 1 },
    "result": { "enum": ["started", "succeeded", "failed"] },
    "recorded_at_epoch": { "type": "integer", "minimum": 1 },
    "prompt_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "usage": { "type": "object" },
    "error": { "type": "string" },
    "cost_state": {
      "enum": [
        "KNOWN_COST",
        "RECONSTRUCTED_COST",
        "UNKNOWN_COST",
        "SUBSCRIPTION_NO_INCREMENTAL_METER",
        "PROVIDER_BILLED_UNATTRIBUTED",
        "UNAVAILABLE_USAGE"
      ]
    }
  },
  "additionalProperties": false
}
