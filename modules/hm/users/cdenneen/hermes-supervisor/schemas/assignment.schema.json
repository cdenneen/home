{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis.external-development-supervisor.assignment",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "assignment_id",
    "project",
    "work_item",
    "planning_record",
    "allowed_paths",
    "required_tests"
  ],
  "properties": {
    "schema": { "const": "axis.external-development-supervisor.assignment" },
    "schema_version": { "const": "1.0.0" },
    "assignment_id": { "type": "string", "minLength": 1 },
    "lifecycle_state": {
      "enum": [
        "ready-semantic",
        "ready-implementation",
        "running-semantic",
        "running-implementation",
        "awaiting-integration",
        "completed",
        "waiting",
        "blocked",
        "failed",
        "cancelled",
        "recovery-required"
      ]
    },
    "state": {
      "enum": [
        "ready",
        "active",
        "waiting",
        "blocked",
        "complete",
        "completed",
        "cancelled",
        "failed"
      ]
    },
    "phase": {
      "enum": [
        "semantic",
        "semantic-complete",
        "implementation",
        "awaiting-integration",
        "integration",
        "integrated",
        "failed",
        "recovery"
      ]
    },
    "project": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "work_item": { "type": "string", "minLength": 1 },
    "planning_record": {
      "type": ["object", "null"],
      "required": ["revision", "digest", "approval_note"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "approval_note": { "type": "string", "format": "uri" }
      },
      "additionalProperties": true
    },
    "allowed_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_tests": {
      "type": "array",
      "items": { "type": "string" }
    },
    "lease_id": { "type": ["string", "null"] },
    "lease_uri": { "type": ["string", "null"], "format": "uri" },
    "completion_receipt": {
      "$ref": "axis.external-development-supervisor.verification"
    },
    "source_inventory_generation_id": { "type": ["string", "null"] }
  },
  "oneOf": [
    {
      "required": ["lifecycle_state"],
      "not": {
        "anyOf": [{ "required": ["state"] }, { "required": ["phase"] }]
      }
    },
    {
      "required": ["state", "phase"],
      "not": { "required": ["lifecycle_state"] }
    }
  ],
  "additionalProperties": true
}
