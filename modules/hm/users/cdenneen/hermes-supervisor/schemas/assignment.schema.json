{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis.external-development-supervisor.assignment",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "assignment_id",
    "project",
    "responsibility",
    "repository_ownership",
    "work_item",
    "planning_record",
    "allowed_paths",
    "required_tests",
    "assignment_type",
    "result_state",
    "work_item_disposition",
    "action_contract",
    "mutation_grant_id",
    "mutation_grant_uri"
  ],
  "properties": {
    "schema": { "const": "axis.external-development-supervisor.assignment" },
    "schema_version": { "const": "3.0.0" },
    "assignment_id": { "type": "string", "minLength": 1 },
    "assignment_type": {
      "enum": [
        "read-only-analysis",
        "governance-document-mutation",
        "code-implementation",
        "ci-integration-repair",
        "capability-deployment",
        "repository-convergence",
        "no-op-verification"
      ]
    },
    "result_state": {
      "enum": [
        "pending",
        "analysis-completed",
        "no-op-verification-completed",
        "implementation-commit-created",
        "implementation-complete",
        "awaiting-integration",
        "integrated-post-main-verified",
        "repository-convergence-pending",
        "repository-converged",
        "runtime-convergence-pending",
        "runtime-converged",
        "canonical-complete",
        "deployment-failed",
        "waiting",
        "blocked",
        "failed",
        "cancelled",
        "recovery-required"
      ]
    },
    "work_item_disposition": {
      "enum": [
        "not-evaluated",
        "analyzed-only",
        "no-op-verified",
        "requires-implementation",
        "requires-human-decision",
        "requires-integration",
        "evidence-recorded-awaiting-fresh-recognition",
        "requires-repository-convergence",
        "requires-runtime-convergence",
        "canonical-complete"
      ]
    },
    "lifecycle_state": {
      "enum": [
        "ready-semantic",
        "ready-implementation",
        "running-semantic",
        "running-implementation",
        "implementation-complete",
        "awaiting-integration",
        "integrated-post-main-verified",
        "repository-convergence-pending",
        "repository-converged",
        "runtime-convergence-pending",
        "runtime-converged",
        "canonical-complete",
        "deployment-failed",
        "completed",
        "waiting",
        "blocked",
        "failed",
        "cancelled",
        "recovery-required"
      ]
    },
    "state": {
      "enum": [
        "ready",
        "active",
        "waiting",
        "blocked",
        "complete",
        "completed",
        "cancelled",
        "failed"
      ]
    },
    "phase": {
      "enum": [
        "semantic",
        "semantic-complete",
        "implementation",
        "awaiting-integration",
        "integration",
        "integrated",
        "failed",
        "recovery"
      ]
    },
    "project": { "type": "string", "pattern": "^[^/]+/[^/]+$" },
    "responsibility": {
      "enum": [
        "supervisor-orchestration/temporary-slack/cron",
        "axis-runtime/product",
        "contracts/planning-records",
        "deployment/realistic-validation"
      ]
    },
    "repository_ownership": { "type": "object" },
    "work_item": { "type": "string", "minLength": 1 },
    "planning_record": {
      "type": ["object", "null"],
      "required": ["revision", "digest", "approval_note"],
      "properties": {
        "revision": { "type": "integer", "minimum": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "approval_note": { "type": "string", "format": "uri" }
      },
      "additionalProperties": true
    },
    "allowed_paths": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_tests": {
      "type": "array",
      "items": { "type": "string" }
    },
    "lease_id": { "type": ["string", "null"] },
    "lease_uri": { "type": ["string", "null"], "format": "uri" },
    "mutation_grant_id": { "type": ["string", "null"] },
    "mutation_grant_uri": { "type": ["string", "null"], "format": "uri" },
    "completion_receipt": {
      "$ref": "axis.external-development-supervisor.verification"
    },
    "source_inventory_generation_id": { "type": ["string", "null"] },
    "action_contract": {
      "type": ["object", "null"],
      "required": [
        "action_id",
        "source_ref",
        "engineering_purpose",
        "gate_owner",
        "expected_gates",
        "expected_capabilities",
        "expected_milestones",
        "expected_debt_reduction",
        "expected_evidence",
        "convergence_fingerprint",
        "evidence_model_fingerprint",
        "suppression_fingerprint"
      ],
      "properties": {
        "action_id": { "type": "string", "minLength": 1 },
        "source_ref": { "type": ["string", "null"] },
        "engineering_purpose": { "type": "string", "minLength": 1 },
        "gate_owner": { "type": "string", "minLength": 1 },
        "expected_gates": { "type": "array" },
        "expected_capabilities": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expected_milestones": {
          "type": "array",
          "items": { "type": "string" }
        },
        "expected_debt_reduction": { "type": "array" },
        "expected_evidence": { "type": "array", "items": { "type": "string" } },
        "convergence_fingerprint": { "type": ["string", "null"] },
        "evidence_model_fingerprint": { "type": "string" },
        "applicability_model_revision": { "type": "string" },
        "pre_snapshot": { "type": "object" },
        "suppression_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "required": ["lifecycle_state"],
      "not": {
        "anyOf": [{ "required": ["state"] }, { "required": ["phase"] }]
      }
    },
    {
      "required": ["state", "phase"],
      "not": { "required": ["lifecycle_state"] }
    }
  ],
  "additionalProperties": true
}
