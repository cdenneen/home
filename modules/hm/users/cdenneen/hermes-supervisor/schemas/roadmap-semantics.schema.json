{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis.external-development-supervisor.roadmap-semantics",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "semantic_revision",
    "generated_at",
    "source",
    "staleness",
    "verification_standard",
    "verification_scope",
    "total_governed_items",
    "composition",
    "coverage",
    "complete_roadmap",
    "active_execution",
    "strategic_programs",
    "roadmap_endpoint",
    "current_execution_frontier",
    "scheduler_state",
    "current_supervisor_focus",
    "supervisor_work",
    "executable_sources",
    "ready_queue",
    "verified_items",
    "revalidation_plan"
  ],
  "properties": {
    "schema": {
      "const": "axis.external-development-supervisor.roadmap-semantics"
    },
    "schema_version": { "const": "1.2.0" },
    "semantic_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "generated_at": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "required": [
        "inventory_revision",
        "graph_generation_id",
        "deployed_revision"
      ]
    },
    "staleness": { "$ref": "#/$defs/staleness" },
    "verification_standard": {
      "type": "object",
      "required": ["label", "definition"]
    },
    "verification_scope": { "type": "object" },
    "total_governed_items": { "type": "integer", "minimum": 0 },
    "composition": {
      "type": "object",
      "properties": {
        "verified_complete": { "$ref": "#/$defs/metric" },
        "closed_pending_revalidation": { "$ref": "#/$defs/metric" },
        "running": { "$ref": "#/$defs/metric" },
        "executable": { "$ref": "#/$defs/metric" },
        "waiting": { "$ref": "#/$defs/metric" },
        "blocked": { "$ref": "#/$defs/metric" },
        "invalid_superseded": { "$ref": "#/$defs/metric" },
        "integrated_historical": { "$ref": "#/$defs/metric" },
        "other": { "$ref": "#/$defs/metric" }
      },
      "required": [
        "verified_complete",
        "closed_pending_revalidation",
        "running",
        "executable",
        "waiting",
        "blocked",
        "invalid_superseded",
        "integrated_historical",
        "other"
      ],
      "additionalProperties": false
    },
    "coverage": { "type": "object" },
    "complete_roadmap": { "type": "array" },
    "active_execution": { "type": "array" },
    "strategic_programs": { "type": "array" },
    "roadmap_endpoint": { "type": ["string", "null"] },
    "current_execution_frontier": { "type": ["string", "null"] },
    "scheduler_state": {
      "type": "object",
      "required": [
        "configured_batch_ceiling",
        "available_model_call_budget",
        "selected_batch",
        "deferred_items",
        "next_eligible_work",
        "limiting_constraint",
        "wip_limits",
        "wip_counts",
        "available_capacity",
        "current_constraint"
      ],
      "properties": {
        "configured_batch_ceiling": { "type": "integer", "minimum": 1 },
        "available_model_call_budget": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "selected_batch": { "type": "array", "items": { "type": "object" } },
        "deferred_items": { "type": "array", "items": { "type": "object" } },
        "next_eligible_work": { "type": ["object", "null"] },
        "limiting_constraint": { "type": "string", "minLength": 1 },
        "wip_limits": { "type": "object" },
        "wip_counts": { "type": "object" },
        "available_capacity": { "type": "integer", "minimum": 0 },
        "current_constraint": { "type": "object" }
      },
      "additionalProperties": false
    },
    "current_supervisor_focus": { "type": "object" },
    "supervisor_work": { "type": "object" },
    "executable_sources": { "type": "object" },
    "ready_queue": { "type": "object" },
    "verified_items": { "type": "array" },
    "revalidation_plan": { "type": "object" }
  },
  "$defs": {
    "metric": {
      "type": "object",
      "required": ["label", "count", "denominator", "percent"],
      "properties": {
        "label": { "type": "string" },
        "count": { "type": "integer", "minimum": 0 },
        "denominator": { "type": "integer", "minimum": 0 },
        "percent": { "type": "number", "minimum": 0, "maximum": 100 }
      },
      "additionalProperties": false
    },
    "staleness": {
      "type": "object",
      "required": [
        "state",
        "source_generations_match",
        "source_age_seconds",
        "source_inventory_revision",
        "graph_inventory_revision",
        "reason"
      ],
      "properties": {
        "state": { "enum": ["current", "stale"] },
        "source_generations_match": { "type": "boolean" },
        "source_age_seconds": { "type": "integer", "minimum": 0 },
        "source_inventory_revision": { "type": ["string", "null"] },
        "graph_inventory_revision": { "type": ["string", "null"] },
        "reason": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
