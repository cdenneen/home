{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis.external-development-supervisor.independent-review-output",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "reviewed_sha",
    "diff_digest",
    "summary",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "axis.external-development-supervisor.independent-review-output"
    },
    "schema_version": { "const": "1.0.0" },
    "reviewed_sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "diff_digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "path", "line", "body"],
        "properties": {
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "path": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"], "minimum": 1 },
          "body": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
