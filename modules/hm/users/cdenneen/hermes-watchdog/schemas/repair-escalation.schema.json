{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "axis.development-watchdog.repair-escalation",
  "type": "object",
  "required": [
    "schema",
    "schema_version",
    "escalation_id",
    "incident_id",
    "repository",
    "authority",
    "diagnostic_mode",
    "diagnosis",
    "requested_at",
    "allowed_scope",
    "product_dispatch_allowed"
  ],
  "properties": {
    "schema": { "const": "axis.development-watchdog.repair-escalation" },
    "schema_version": { "const": "1.0.0" },
    "escalation_id": { "type": "string", "minLength": 1 },
    "incident_id": { "type": "string", "minLength": 1 },
    "repository": { "const": "cdenneen/home" },
    "authority": { "const": "bounded-watchdog-repair" },
    "diagnostic_mode": { "const": "pinned-hermes-no-tools-read-only" },
    "diagnosis": { "type": "string", "minLength": 1, "maxLength": 1200 },
    "requested_at": { "type": "string", "format": "date-time" },
    "allowed_scope": {
      "type": "array",
      "items": {
        "enum": [
          "modules/hm/users/cdenneen/hermes-supervisor",
          "modules/hm/users/cdenneen/hermes-watchdog"
        ]
      },
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true
    },
    "product_dispatch_allowed": { "const": false }
  },
  "additionalProperties": false
}
