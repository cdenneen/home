#!/usr/bin/env zsh
set -euo pipefail

quiet=0
[[ "${1:-}" == "--quiet" ]] && quiet=1

secrets_file="$HOME/.secrets"
my="my"

op_svc_token_file="$HOME/.config/sops-nix/secrets/op_service_account_token_ap"

has_op() { command -v op >/dev/null 2>&1 }
has_op_accounts() { has_op && op account list >/dev/null 2>&1 }
is_my_account_unlocked() { has_op_accounts && op account get --account "$my" >/dev/null 2>&1 }

op_required() {
  local label="$1"
  local ref="$2"
  local account="${3:-}"

  local value
  if [[ -n "$account" ]]; then
    value="$(op read "$ref" --account "$account" 2>/dev/null || true)"
  else
    value="$(op read "$ref" 2>/dev/null || true)"
  fi

  if [[ -z "$value" ]]; then
    echo "update-secrets: missing secret: $label" >&2
    echo "  ref: $ref" >&2
    [[ -n "$account" ]] && echo "  account: $account" >&2
    exit 1
  fi

  print -r -- "$value"
}

refresh_my_account() {
  has_op_accounts || return 1
  if ! is_my_account_unlocked; then
    (( quiet )) || echo "1Password (personal) locked; signing in…"
    eval "$(op signin --account \"$my\")" || return 1
  fi
  return 0
}

tmp="$secrets_file.tmp"
: > "$tmp"

# Work (AP) secrets: authenticate via a dedicated service account scoped to the
# cdenneen-env vault, so this works headlessly with no interactive signin/SSO.
if has_op && [[ -r "$op_svc_token_file" ]]; then
  export OP_SERVICE_ACCOUNT_TOKEN="$(<"$op_svc_token_file")"
  {
    echo "export AZURE_DEFAULT_USERNAME=\"$(op_required AZURE_DEFAULT_USERNAME 'op://cdenneen-env/Office 365/username')\""
    echo "export AZURE_DEFAULT_PASSWORD=\"$(op_required AZURE_DEFAULT_PASSWORD 'op://cdenneen-env/Office 365/password')\""
    gitlab_pat="$(op_required GITLAB_PERSONAL_ACCESS_TOKEN 'op://cdenneen-env/GitLab Personal Access Token/token')"
    echo "export GITLAB_PERSONAL_ACCESS_TOKEN=\"$gitlab_pat\""
    echo "export TF_HTTP_PASSWORD=\"$(op_required TF_HTTP_PASSWORD 'op://cdenneen-env/GitLab Personal Access Token/token')\""
    echo "export TF_HTTP_USERNAME=\"$(op_required TF_HTTP_USERNAME 'op://cdenneen-env/GitLab Personal Access Token/username')\""
    echo "export TF_VAR_gitlab_token=\"$(op_required TF_VAR_gitlab_token 'op://cdenneen-env/GitLab_tfadmin-cdenneen/credential')\""
    echo "export CI_REGISTRY_USER=\"$(op_required CI_REGISTRY_USER 'op://cdenneen-env/JFrog_gitlabci/username')\""
    echo "export CI_REGISTRY_PASSWORD=\"$(op_required CI_REGISTRY_PASSWORD 'op://cdenneen-env/JFrog_gitlabci/credential')\""
    echo "export GI_RENOVATE_TOKEN=\"$(op_required GI_RENOVATE_TOKEN 'op://cdenneen-env/GitLab_gi-renovate/credential')\""
    echo "export RENOVATE_TOKEN=\"$(op_required RENOVATE_TOKEN 'op://cdenneen-env/GitLab_renovate-runner-ci/credential')\""
    echo "export DOCKER_HUB_PASSWORD=\"$(op_required DOCKER_HUB_PASSWORD 'op://cdenneen-env/DockerHub_token/credential')\""
    echo "export OPENAI_API_KEY=\"$(op_required OPENAI_API_KEY 'op://cdenneen-env/OpenAI/credential')\""
  } >> "$tmp"
  unset OP_SERVICE_ACCOUNT_TOKEN
else
  (( quiet )) || echo "update-secrets: op service-account token not found at $op_svc_token_file; skipping work secrets."
fi

# Personal secrets: still interactive, since the personal account isn't SSO-gated.
if refresh_my_account; then
  {
    echo "export GITHUB_TOKEN=\"$(op_required GITHUB_TOKEN 'op://private/GH_TOKEN/token' "$my")\""
    echo 'export NIX_CONFIG="${NIX_CONFIG:+$NIX_CONFIG }access-tokens = github.com=${GITHUB_TOKEN}"'
  } >> "$tmp"
else
  (( quiet )) || echo "update-secrets: personal 1Password account not available; skipping GITHUB_TOKEN."
fi

if ! cmp -s "$tmp" "$secrets_file" 2>/dev/null; then
  mv "$tmp" "$secrets_file"
  (( quiet )) || echo "Secrets updated in $secrets_file"
else
  rm -f "$tmp"
fi

if [ -r "$secrets_file" ]; then
  source "$secrets_file"
fi
