#!/usr/bin/env zsh
set -euo pipefail

quiet=0
[[ "${1:-}" == "--quiet" ]] && quiet=1

secrets_file="$HOME/.secrets"
my="my"

op_svc_token_file="${OP_AP_SERVICE_ACCOUNT_TOKEN_FILE:-$HOME/.config/sops-nix/secrets/op_service_account_token_ap}"
op_primary_work_vault="${OP_AP_WORK_VAULT:-${OP_AP_DEFAULT_VAULT:-gss}}"
op_fallback_work_vault="${OP_AP_FALLBACK_VAULT:-cdenneen-env}"

has_op() { command -v op >/dev/null 2>&1 }
has_op_accounts() { has_op && op account list >/dev/null 2>&1 }
is_my_account_unlocked() { has_op_accounts && op account get --account "$my" >/dev/null 2>&1 }
resolve_op_service_token_file() {
  local uid candidate
  local -a runtime_candidates

  uid="$(id -u)"
  runtime_candidates=(/run/user/$uid/secrets.d/*/op_service_account_token_ap(N))

  for candidate in \
    "$op_svc_token_file" \
    "$HOME/.local/share/sops-nix/secrets/op_service_account_token_ap" \
    "/run/user/$uid/secrets/op_service_account_token_ap" \
    "$runtime_candidates[@]"; do
    [[ -r "$candidate" ]] && { print -r -- "$candidate"; return 0; }
  done

  return 1
}

resolve_op_work_vault() {
  local preferred="$1"
  local fallback="$2"

  if op vault get "$preferred" >/dev/null 2>&1; then
    print -r -- "$preferred"
    return 0
  fi

  if [[ -n "$fallback" ]] && op vault get "$fallback" >/dev/null 2>&1; then
    (( quiet )) || echo "update-secrets: vault '$preferred' not accessible; using '$fallback'."
    print -r -- "$fallback"
    return 0
  fi

  echo "update-secrets: no accessible work vault (tried '$preferred' and '$fallback')." >&2
  return 1
}

op_required() {
  local label="$1"
  local ref="$2"
  local account="${3:-}"

  local value
  if [[ -n "$account" ]]; then
    value="$(op read "$ref" --account "$account" 2>/dev/null || true)"
  else
    value="$(op read "$ref" 2>/dev/null || true)"
  fi

  if [[ -z "$value" ]]; then
    echo "update-secrets: missing secret: $label" >&2
    echo "  ref: $ref" >&2
    [[ -n "$account" ]] && echo "  account: $account" >&2
    exit 1
  fi

  print -r -- "$value"
}

op_required_work() {
  local label="$1"
  local work_path="$2"
  local primary_ref fallback_ref value

  primary_ref="op://$op_work_vault/$work_path"
  value="$(op read "$primary_ref" 2>/dev/null || true)"

  if [[ -z "$value" ]] && [[ -n "${op_work_fallback_vault:-}" ]] && [[ "$op_work_vault" != "$op_work_fallback_vault" ]]; then
    fallback_ref="op://$op_work_fallback_vault/$work_path"
    value="$(op read "$fallback_ref" 2>/dev/null || true)"
  fi

  if [[ -z "$value" ]]; then
    echo "update-secrets: missing secret: $label" >&2
    echo "  refs tried: $primary_ref" >&2
    [[ -n "${fallback_ref:-}" ]] && echo "              $fallback_ref" >&2
    exit 1
  fi

  print -r -- "$value"
}

refresh_my_account() {
  has_op_accounts || return 1
  if ! is_my_account_unlocked; then
    (( quiet )) || echo "1Password (personal) locked; signing in…"
    eval "$(op signin --account \"$my\")" || return 1
  fi
  return 0
}

tmp="$secrets_file.tmp"
: > "$tmp"

# Work (AP) secrets: authenticate via a dedicated service account scoped to the
# selected AP vault, so this works headlessly with no interactive signin/SSO.
op_svc_token_file="$(resolve_op_service_token_file 2>/dev/null || true)"
if has_op && [[ -n "$op_svc_token_file" ]]; then
  op_work_vault=""
  op_work_fallback_vault="$op_fallback_work_vault"
  export OP_SERVICE_ACCOUNT_TOKEN="$(<"$op_svc_token_file")"
  op_work_vault="$(resolve_op_work_vault "$op_primary_work_vault" "$op_fallback_work_vault")"
  {
    echo "export AZURE_DEFAULT_USERNAME=\"$(op_required_work AZURE_DEFAULT_USERNAME 'Office 365/username')\""
    echo "export AZURE_DEFAULT_PASSWORD=\"$(op_required_work AZURE_DEFAULT_PASSWORD 'Office 365/password')\""
    gitlab_pat="$(op_required_work GITLAB_PERSONAL_ACCESS_TOKEN 'GitLab Personal Access Token/token')"
    echo "export GITLAB_PERSONAL_ACCESS_TOKEN=\"$gitlab_pat\""
    echo "export TF_HTTP_PASSWORD=\"$(op_required_work TF_HTTP_PASSWORD 'GitLab Personal Access Token/token')\""
    echo "export TF_HTTP_USERNAME=\"$(op_required_work TF_HTTP_USERNAME 'GitLab Personal Access Token/username')\""
    echo "export TF_VAR_gitlab_token=\"$(op_required_work TF_VAR_gitlab_token 'GitLab_tfadmin-cdenneen/credential')\""
    echo "export CI_REGISTRY_USER=\"$(op_required_work CI_REGISTRY_USER 'JFrog_gitlabci/username')\""
    echo "export CI_REGISTRY_PASSWORD=\"$(op_required_work CI_REGISTRY_PASSWORD 'JFrog_gitlabci/credential')\""
    echo "export GI_RENOVATE_TOKEN=\"$(op_required_work GI_RENOVATE_TOKEN 'GitLab_gi-renovate/credential')\""
    echo "export RENOVATE_TOKEN=\"$(op_required_work RENOVATE_TOKEN 'GitLab_renovate-runner-ci/credential')\""
    echo "export DOCKER_HUB_PASSWORD=\"$(op_required_work DOCKER_HUB_PASSWORD 'DockerHub_token/credential')\""
    echo "export OPENAI_API_KEY=\"$(op_required_work OPENAI_API_KEY 'OpenAI/credential')\""
  } >> "$tmp"
  unset OP_SERVICE_ACCOUNT_TOKEN
else
  (( quiet )) || echo "update-secrets: op service-account token not found at $op_svc_token_file; skipping work secrets."
fi

# Personal secrets: still interactive, since the personal account isn't SSO-gated.
github_token=""
if [[ -r "$HOME/.config/sops-nix/secrets/github-token" ]]; then
  github_token="$(tr -d '\n\r' < "$HOME/.config/sops-nix/secrets/github-token")"
fi
if [[ -z "$github_token" ]] && command -v gh >/dev/null 2>&1; then
  github_token="$(gh auth token 2>/dev/null || true)"
fi
if [[ -z "$github_token" ]] && refresh_my_account; then
  github_token="$(op_required GITHUB_TOKEN 'op://private/GH_TOKEN/token' "$my")"
fi

if [[ -n "$github_token" ]]; then
  gitlab_clone_token=""
  if [[ -r "$HOME/.config/sops-nix/secrets/gitlab_git_clone_token" ]]; then
    gitlab_clone_token="$(tr -d '\n\r' < "$HOME/.config/sops-nix/secrets/gitlab_git_clone_token")"
  fi

  access_tokens="github.com=$github_token"
  if [[ -n "$gitlab_clone_token" ]]; then
    access_tokens="$access_tokens gitlab.com=$gitlab_clone_token"
  fi

  {
    echo "export GITHUB_TOKEN=\"$github_token\""
    echo "export NIX_CONFIG=\"access-tokens = $access_tokens\""
  } >> "$tmp"
else
  (( quiet )) || echo "update-secrets: personal 1Password account not available; skipping GITHUB_TOKEN."
fi

if ! cmp -s "$tmp" "$secrets_file" 2>/dev/null; then
  mv "$tmp" "$secrets_file"
  (( quiet )) || echo "Secrets updated in $secrets_file"
else
  rm -f "$tmp"
fi

if [ -r "$secrets_file" ]; then
  source "$secrets_file"
fi
