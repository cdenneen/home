{
  "$id": "https://example.invalid/phase-b/consumption.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "maxProperties": 12,
  "minProperties": 12,
  "properties": {
    "attempt_id": {
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
    },
    "authorization_grant_digest": {
      "maxLength": 8192,
      "minLength": 1,
      "pattern": "sha256:[0-9a-f]{64}",
      "type": "string"
    },
    "consumer_identity": {
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
    },
    "consumer_nonce": {
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
    },
    "continued_at": {
      "maxLength": 64,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "type": "string"
    },
    "expected_counter": {
      "minimum": 0,
      "type": "integer"
    },
    "grant_expires_at": {
      "maxLength": 64,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?Z$",
      "type": "string"
    },
    "previous_receipt_digest": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "pattern": "sha256:[0-9a-f]{64}",
          "type": "string"
        }
      ]
    },
    "receipt_digest": {
      "maxLength": 8192,
      "minLength": 1,
      "pattern": "sha256:[0-9a-f]{64}",
      "type": "string"
    },
    "receiver_head": {
      "maxLength": 8192,
      "minLength": 1,
      "pattern": "sha256:[0-9a-f]{64}",
      "type": "string"
    },
    "requested_transition": {
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "phase-b.consumption.v1"
    }
  },
  "required": [
    "attempt_id",
    "authorization_grant_digest",
    "consumer_identity",
    "consumer_nonce",
    "continued_at",
    "expected_counter",
    "grant_expires_at",
    "previous_receipt_digest",
    "receipt_digest",
    "receiver_head",
    "requested_transition",
    "schema"
  ],
  "type": "object"
}
