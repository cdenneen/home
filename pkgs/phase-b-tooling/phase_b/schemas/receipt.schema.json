{
  "$id": "https://example.invalid/phase-b/receipt.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "maxProperties": 20,
  "minProperties": 20,
  "properties": {
    "attempt_id": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "authorization_grant": {
      "additionalProperties": false,
      "maxProperties": 4,
      "minProperties": 4,
      "properties": {
        "digest": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": "sha256:[0-9a-f]{64}",
          "type": "string"
        },
        "id": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "media_type": {
          "maxLength": 4096,
          "minLength": 1,
          "type": "string"
        },
        "owner_only": {
          "type": "boolean"
        }
      },
      "required": ["digest", "id", "media_type", "owner_only"],
      "type": "object"
    },
    "authorization_grant_digest": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "sha256:[0-9a-f]{64}",
      "type": "string"
    },
    "baseline_digest": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "sha256:[0-9a-f]{64}",
      "type": "string"
    },
    "consumer_identity": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "consumer_nonce": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "consumption_counter": {
      "minimum": 0,
      "type": "integer"
    },
    "continuation_digest": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "sha256:[0-9a-f]{64}",
      "type": "string"
    },
    "execution_journal_head": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "sha256:[0-9a-f]{64}",
      "type": "string"
    },
    "f0_digest": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "sha256:[0-9a-f]{64}",
      "type": "string"
    },
    "issued_at": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z",
      "type": "string"
    },
    "observation_chain_head": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "sha256:[0-9a-f]{64}",
      "type": "string"
    },
    "observation_digest": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "sha256:[0-9a-f]{64}",
      "type": "string"
    },
    "observed_through_at": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}T.*Z",
      "type": "string"
    },
    "previous_receipt_digest": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      ]
    },
    "receiver_head": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "sha256:[0-9a-f]{64}",
      "type": "string"
    },
    "reconstruction_digests": {
      "items": {
        "maxLength": 4096,
        "minLength": 1,
        "pattern": "sha256:[0-9a-f]{64}",
        "type": "string"
      },
      "maxItems": 2048,
      "minItems": 1,
      "type": "array"
    },
    "requested_transition": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
    },
    "schema": {
      "const": "phase-b.receipt.v2"
    },
    "verified_chain_accumulator": {
      "maxLength": 4096,
      "minLength": 1,
      "pattern": "sha256:[0-9a-f]{64}",
      "type": "string"
    }
  },
  "required": [
    "attempt_id",
    "authorization_grant",
    "authorization_grant_digest",
    "baseline_digest",
    "consumer_identity",
    "consumer_nonce",
    "consumption_counter",
    "continuation_digest",
    "execution_journal_head",
    "f0_digest",
    "issued_at",
    "observation_chain_head",
    "observation_digest",
    "observed_through_at",
    "previous_receipt_digest",
    "receiver_head",
    "reconstruction_digests",
    "requested_transition",
    "schema",
    "verified_chain_accumulator"
  ],
  "type": "object"
}
